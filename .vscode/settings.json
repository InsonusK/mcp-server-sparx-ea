{
  // --- Go: обнаружение и запуск тестов ---------------------------------------
  // Проект чистый Go (CGO_ENABLED=0), внешних C-зависимостей нет.
  "go.testEnvVars": {
    // godog печатает человекочитаемый вывод сценариев
    "GODOG_FORMAT": "pretty"
  },
  // -v: показывать вывод логов из каждого шага даже на зелёном прогоне
  // (без -v go test прячет вывод прошедших тестов). См.
  // docs/skills/cucumber-go-testing.md §4.
  "go.testFlags": [
    "-v"
  ],
  // godog-сценарии медленнее обычных unit-тестов; project_architecture
  // кросс-компилирует бинарь под несколько платформ
  "go.testTimeout": "300s",
  "go.useLanguageServer": true,
  "go.testExplorer.enable": true,
  "go.testExplorer.showDynamicSubtestsInEditor": true,
  "go.enableCodeLens": {
    "runtest": true
  },
  "gopls": {
    "build.directoryFilters": [
      "-**/node_modules"
    ]
  },

  // --- Cucumber (feature-файлы) -------------------------------------------
  "cucumber.glue": [
    "**/*_test.go",
    "**/test/**/*.go"
  ],
  "cucumber.features": [
    "**/*.feature"
  ]
}
